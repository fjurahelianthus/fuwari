/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 2px
  --content-delay 150ms
  --paper-shadow 0 1px 0 rgba(255,255,255,0.45), 0 10px 30px rgba(62,47,31,0.08)
  --paper-inset inset 0 0 0 1px rgba(255,255,255,0.35)

:root.dark
  --paper-shadow 0 1px 0 rgba(255,255,255,0.04), 0 14px 34px rgba(0,0,0,0.28)
  --paper-inset inset 0 0 0 1px rgba(255,255,255,0.04)

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: oklch(0.43 0.10 22) oklch(0.72 0.09 24)
  --page-bg: oklch(0.89 0.018 82) oklch(0.18 0.014 70)
  --card-bg: oklch(0.965 0.016 84) oklch(0.235 0.012 72)

  --btn-content: oklch(0.38 0.08 22) oklch(0.78 0.07 24)

  --btn-regular-bg: oklch(0.91 0.018 82) oklch(0.28 0.014 72)
  --btn-regular-bg-hover: oklch(0.86 0.024 78) oklch(0.34 0.018 72)
  --btn-regular-bg-active: oklch(0.80 0.030 74) oklch(0.39 0.022 72)

  --btn-plain-bg-hover: oklch(0.91 0.018 82) oklch(0.29 0.014 72)
  --btn-plain-bg-active: oklch(0.84 0.026 78) oklch(0.34 0.018 72)

  --btn-card-bg-hover: oklch(0.93 0.016 84) oklch(0.30 0.014 72)
  --btn-card-bg-active: oklch(0.86 0.025 78) oklch(0.35 0.018 72)

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.24 0.018 72)

  --title-active: oklch(0.34 0.09 22)

  --line-divider: black(0.16) white(0.12)

  --line-color: rgba(80, 64, 43, 0.22) rgba(230, 220, 198, 0.14)
  --meta-divider: rgba(80, 64, 43, 0.36) rgba(230, 220, 198, 0.26)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.80 0.055 38) oklch(0.38 0.05 28)
  --codeblock-selection: oklch(0.36 0.045 28)
  --codeblock-bg: oklch(0.22 0.014 72) oklch(0.17 0.012 72)
  --codeblock-topbar-bg: oklch(0.31 0.014 72) oklch(0.12 0.010 72)

  --license-block-bg: black(0.03) var(--codeblock-bg)

  --link-underline: oklch(0.78 0.05 34) oklch(0.42 0.05 28)
  --link-hover: oklch(0.86 0.032 44) oklch(0.36 0.045 28)
  --link-active: oklch(0.80 0.05 34) oklch(0.32 0.05 28)

  --float-panel-bg: oklch(0.96 0.016 84) oklch(0.21 0.012 72)

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.7 0.14 180) oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250) oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310) oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60) oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25) oklch(0.65 0.2 25)

  --toc-badge-bg: oklch(0.84 0.035 44) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.91 0.018 82) oklch(0.26 0.014 72)
  --toc-btn-active: oklch(0.84 0.026 78) oklch(0.31 0.018 72)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.43 0.10 22) oklch(0.72 0.09 24)
})
